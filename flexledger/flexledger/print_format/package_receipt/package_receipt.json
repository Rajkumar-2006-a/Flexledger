 "html": "{{letter_head}}\n<h1>{{get_studio_name()}}</h1>\n<h2>Member Section</h2>\n\n{%set mem=frappe.get_doc(\"MEMBER\",doc.member)%}\n<table class=\"table table-bordered \">\n    <thead>\n      <tr>\n        <th>Memeber ID</th>\n        <td>{{mem.name}}</td>\n      </tr>\n      <tr>\n        <th>Memeber Name </th>\n        <td>{{mem.member_name}}</td>\n      </tr>\n      <tr>\n        <th>Phone </th>\n        <td>{{mem.phone}}</td>\n      </tr>\n      <tr>\n        <th> Memeber Status </th>\n        <td>{{mem.status}}</td>\n      </tr>\n    </thead>\n </table>\n  \n<h2>Package Section</h2>\n{% if doc.status == \"Expired\" %}\n\n<h1>Package Status : Expired</h1>\n{% endif %}\n<table class=\"table table-bordered\">\n    <thead>\n      <tr>\n        <th>Total Credits </th>\n        <td>{{doc.total_credits}}</td>\n      </tr>\n      <tr>\n        <th>Amount Paid </th>\n        <td>{{doc.amount_paid}}</td>\n      </tr>\n      <tr>\n        <th>Expiry</th>\n        <td>{{doc.expirey_date}}</td>\n      </tr>\n    </thead>\n  </table>\n<div class=\"credits-remaining\">\n    Credits Remaining:\n    {{ frappe.format_value(doc.credits_remaining, \"Int\") }}\n</div>\n{{footer}}\n",
